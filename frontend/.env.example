# Frontend configuration (Vite)
# API requests to /api are proxied to the backend by vite.config.ts,
# so no base URL is required for local development.
# Override here if you point the frontend at a remote backend:
# VITE_API_BASE_URL=http://localhost:8000

# Clerk publishable key (from the Clerk Dashboard → API keys, React). Required.
VITE_CLERK_PUBLISHABLE_KEY=
