# Backend configuration
APP_NAME=grep-pdf API
ENVIRONMENT=development
# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173
# Postgres (with the pgvector extension) connection URL — uses the psycopg v3 driver.
# Points at a local Postgres on the default port 5432 (e.g. Postgres.app / a native
# install) with the pgvector extension available.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/grep_pdf
# Clerk backend secret key (from the Clerk Dashboard → API keys). Server-side only.
CLERK_SECRET_KEY=
