# Backend configuration
APP_NAME=grep-pdf API
ENVIRONMENT=development
# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173
# Directory holding the built frontend bundle that FastAPI serves. Empty in local
# dev (the Vite dev server owns the frontend); the Docker image sets this to the
# copied bundle so one process serves the SPA + /api (see docs/deployment.md).
STATIC_DIR=
# Clerk Frontend API origin for a deployed (production) Clerk instance, e.g.
# https://clerk.your-domain.com — widens the SPA's CSP so Clerk's JS/XHR/frames
# load. Dev instances (*.clerk.accounts.dev) are always allowed; leave empty in dev.
CLERK_FRONTEND_API=
# Postgres (with the pgvector extension) connection URL — uses the psycopg v3 driver.
# Points at a local Postgres on the default port 5432 (e.g. Postgres.app / a native
# install) with the pgvector extension available.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/grep_pdf
# Clerk backend secret key (from the Clerk Dashboard → API keys). Server-side only.
CLERK_SECRET_KEY=
# Voyage AI API key, used to embed PDF chunks (voyage-3-lite, 512-dim).
VOYAGE_API_KEY=
# Anthropic API key for the answer chain (LangChain ChatAnthropic; see docs/llm.md).
ANTHROPIC_API_KEY=
# Answer-chain model. Default Haiku 4.5; override for higher-quality answers.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Base directory uploaded PDFs are written under (one subfolder per user id).
# Local path in dev; set to the Railway Volume mount path in production.
STORAGE_BASE_PATH=./var/uploads
# Max accepted upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800
# Per-user rate limit for the upload endpoint (slowapi syntax).
UPLOAD_RATE_LIMIT=10/minute
# Per-user rate limit for the process endpoint (looser so retries aren't blocked).
PROCESS_RATE_LIMIT=30/minute
# Per-user rate limit for the chat/ask endpoint.
CHAT_RATE_LIMIT=30/minute
